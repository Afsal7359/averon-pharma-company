# ---------------------------------------------------------------------------
# Supabase — Dashboard → Project Settings → API Keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# New-style publishable key. Legacy projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY
# instead — the app accepts either.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Used by the keep-alive cron. Never expose to the browser.
# The "secret" key (sb_secret_…) or the legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Cloudinary — Dashboard → Settings → API Keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_FOLDER=averon
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---------------------------------------------------------------------------
# Keep-alive cron — a long random string; Vercel Cron sends it as a Bearer token
# ---------------------------------------------------------------------------
CRON_SECRET=generate-a-long-random-string

# ---------------------------------------------------------------------------
# Optional: forward contact-form submissions by email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_NOTIFY_TO=info@averonlifesciences.com
CONTACT_NOTIFY_FROM=website@averonlifesciences.com
